#!/user/bin/bash
 isbn="$1"
 ISBN=$(echo "$isbn" | tr -d  -)
 len=${#ISBN}
 if [[ $len -lt 10 || ! "$ISBN" =~ ^[0-9]{9}[0-9X]$ ]]; then
 echo "false"
 exit 0
 fi
sum=0
 if  [[ $ISBN =~ ^[0-9]+X$ ]]; then
 for ((i=0;i<9;i++)); do
 dig="${ISBN:$i:1}"
 num=$(( 10 - i ))
 (( sum+= dig* num ))
 done
 sum=$(( sum + 10))
else
 for ((i=0;i<len-1;i++)); do
 dig="${ISBN:$i:1}"
 num=$(( 10 - i ))
 (( sum+= dig* num ))
 done
 last="${ISBN:9:1}"
 (( sum+= last ))
 fi
 if (( sum % 11 == 0 )); then
 echo "true"
 else
 echo "false"
 fi
